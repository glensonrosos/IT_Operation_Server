NODE_ENV=development
PORT=5000
TRUST_PROXY=false
MONGO_URI=mongodb://localhost:27017/it_service_management
CLIENT_URL=http://localhost:5173
# Optional comma-separated local development preview origins. Development also accepts localhost/127.0.0.1 origins.
DEV_PREVIEW_ORIGINS=
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
UPLOAD_DIR=uploads
LOG_LEVEL=debug